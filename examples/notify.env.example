# Career Console notifications. Copy this file to data/notify.env and fill in ONE channel.
# data/ is never committed. Lines starting with # are comments; no comments after a value.
# Only new verified jobs are sent (company, title, freshness, location, official link).

# email or telegram
NOTIFY_CHANNEL=email

# --- E-mail (Gmail: turn on 2-Step Verification, then create an app password at
#     https://myaccount.google.com/apppasswords and paste it below; never your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=you@gmail.com

# --- Telegram (talk to @BotFather: /newbot, copy the token; then send your new bot any message)
TELEGRAM_BOT_TOKEN=
# optional; found automatically after you message the bot
TELEGRAM_CHAT_ID=
